# Configuración de endpoints. Copiar a .env antes de correr el proyecto:
#
#   cp .env.example .env
#
# Todos los modelos corren en los servidores de la Universidad vía vLLM, con
# API OpenAI-compatible. REQUIEREN VPN institucional activa (GlobalProtect):
# sin ella estas llamadas fallan por timeout/conexión.
#
# Los model id deben escribirse EXACTAMENTE como los devuelve GET /v1/models
# del servidor. Los nombres "amigables" del PDF "Acceso a los Endpoints de
# LLMs" (gemma-4-31B, BGE-M3, glm-ocr) NO coinciden con los ids reales que
# exige la API. Los de abajo están verificados contra el servidor (2026-07-23).

# Chat: Orchestrator + agentes especialistas
VLLM_CHAT_BASE_URL=http://172.28.230.10:12559/v1
VLLM_CHAT_MODEL=google/gemma-4-12B-it

# Embeddings para el RAG de recetas
VLLM_EMBEDDINGS_BASE_URL=http://172.28.230.10:12556/v1
VLLM_EMBEDDINGS_MODEL=BAAI/bge-m3

# OCR/visión para fotos de recetas manuscritas (chat completions con imagen)
VLLM_OCR_BASE_URL=http://172.28.230.10:12560/v1
VLLM_OCR_MODEL=zai-org/GLM-OCR

# Valor ficticio a propósito: el endpoint de la Universidad no valida esta
# clave, pero los SDKs de OpenAI exigen que no esté vacía. El control de
# acceso real lo da el aislamiento de la VPN, no este valor. NO poner aquí
# ninguna credencial real.
VLLM_API_KEY=local

# --- Reconocimiento de voz (Whisper) ---
# Whisper corre LOCAL en la GPU de esta maquina, no en un endpoint remoto: el
# servidor de la Universidad no expone ASR (verificado el 2026-08-19, rango de
# puertos 12550-12575). En un equipo sin GPU usar WHISPER_DEVICE=cpu,
# WHISPER_COMPUTE_TYPE=int8 y un modelo mas chico (small o base).
WHISPER_MODELO=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_IDIOMA=es
