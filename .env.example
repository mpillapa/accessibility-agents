# Configuración de endpoints. Copiar a .env antes de correr el proyecto:
#
#   cp .env.example .env
#
# Los modelos corren en los servidores de la Universidad (vLLM y Ollama, ambos
# con API OpenAI-compatible). REQUIEREN VPN institucional activa
# (GlobalProtect): sin ella estas llamadas fallan por timeout/conexión.
#
# SOBRE LOS ID DE MODELO: no hace falta acertarlos. El proyecto los resuelve
# contra GET /v1/models al arrancar (infraestructura/modelos.py), porque los
# servidores rotan de modelo sin aviso — tres rotaciones en el mismo puerto
# entre el 2026-09-08 y el 2026-09-21. Los valores de abajo son la preferencia
# y el respaldo cuando no hay VPN.
#
# Los nombres "amigables" de la guía de la Universidad (gemma-4-31B, BGE-M3,
# glm-ocr) nunca coincidieron con los ids reales que exige la API, y a
# 2026-09-21 esa guía además documenta cuatro modelos que ya no existen.

# Chat: Orchestrator + agentes especialistas. vLLM en el H200.
VLLM_CHAT_BASE_URL=http://172.28.230.10:12559/v1
VLLM_CHAT_MODEL=canada-quant/GLM-5.3-Flash-W4A16-MTP

# Embeddings para el RAG de recetas. Ollama: el endpoint vLLM de embeddings
# (12556) está caído desde el 2026-09-09. Cambiar de modelo aquí invalida el
# índice de Chroma ya construido (otra dimensión, otro espacio vectorial).
VLLM_EMBEDDINGS_BASE_URL=http://172.28.230.10:11434/v1
VLLM_EMBEDDINGS_MODEL=bge-m3:latest

# OCR/visión para fotos de recetas manuscritas (chat completions con imagen).
# Ollama en otro host: el endpoint vLLM de OCR (12560) está caído desde el
# 2026-09-09. Este NO es el modelo que generó el índice actual (fue GLM-OCR).
VLLM_OCR_BASE_URL=http://172.21.230.33:11434/v1
VLLM_OCR_MODEL=qwen2.5vl:7b

# Valor ficticio a propósito: el endpoint de la Universidad no valida esta
# clave, pero los SDKs de OpenAI exigen que no esté vacía. El control de
# acceso real lo da el aislamiento de la VPN, no este valor. NO poner aquí
# ninguna credencial real.
VLLM_API_KEY=local

# --- Reconocimiento de voz (Whisper) ---
# Whisper corre LOCAL en la GPU de esta maquina, no en un endpoint remoto: el
# servidor de la Universidad no expone ASR (verificado el 2026-08-19, rango de
# puertos 12550-12575). En un equipo sin GPU usar WHISPER_DEVICE=cpu,
# WHISPER_COMPUTE_TYPE=int8 y un modelo mas chico (small o base).
WHISPER_MODELO=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_IDIOMA=es

# --- Trazabilidad con LangSmith (opcional) ---
# Registra cada ejecución del grafo nodo por nodo (entradas, salidas, latencia,
# tokens) en https://smith.langchain.com. LangChain y LangGraph ya están
# instrumentados: alcanza con estas variables.
#
# Sin LANGSMITH_API_KEY el sistema funciona igual, sin trazas.
#
# ATENCIÓN: las trazas incluyen prompts y respuestas COMPLETAS y se envían a
# servidores de LangChain. Para consultas de recetas no hay problema; si alguna
# vez pasara información de salud real, hay que decidirlo a propósito.
#
# La clave se saca de https://smith.langchain.com -> Settings -> API Keys.
# NO la escribas en este archivo: va en .env, que está en .gitignore.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=accessibility-agents
